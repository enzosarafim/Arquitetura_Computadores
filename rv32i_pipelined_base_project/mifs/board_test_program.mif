-- =============================================================================
-- board_test_program.mif
-- Teste da placa DE2-115: da um significado visivel a cada LED, chave e botao.
--
--   LEDR[17:0]  acompanha SW[17:0]
--   LEDG[3:1]   acende enquanto KEY[3:1] estiver pressionado
--   LEDG[0]     sempre apagado (KEY[0] e o reset, nao chega a ser exibido)
--   LEDG[7:4]   sempre apagados
--   LEDG[8]     pisca: bit 23 do contador de ciclos (~0,84 s aceso / ~0,84 s
--               apagado a 10 MHz). Piscando = clock, PLL e CPU funcionando.
--
-- Usa com board_test_data.mif.
-- =============================================================================

DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN

-- ---- Setup ------------------------------------------------------------------
000 : 00002083;  -- lw  x1,  0(x0)    x1 = 0x400       (base MMIO)
001 : 00402283;  -- lw  x5,  4(x0)    x5 = 0x800000    (bit 23 do contador)
002 : 00802303;  -- lw  x6,  8(x0)    x6 = 0x100       (LEDG[8])
003 : 00C02383;  -- lw  x7, 12(x0)    x7 = 0xF         (inverte KEY[3:0])

-- ---- LOOP (word 004) --------------------------------------------------------
004 : 0000A103;  -- lw  x2,  0(x1)    x2 = SW[17:0]    (addr 0x400)
005 : 0020A423;  -- sw  x2,  8(x1)    LEDR = SW        (addr 0x408)
006 : 0040A183;  -- lw  x3,  4(x1)    x3 = KEY[3:0]    (addr 0x404)
007 : 403381B3;  -- sub x3, x7, x3    x3 = 0xF - KEY   (pressionado = 1)
008 : 0140A203;  -- lw  x4, 20(x1)    x4 = ciclos      (addr 0x414)
009 : 00527233;  -- and x4, x4, x5    isola o bit 23
00A : 00020463;  -- beq x4, x0, +8    bit 23 == 0? nao acende LEDG[8]
00B : 006181B3;  -- add x3, x3, x6    acende LEDG[8]
00C : 0030A623;  -- sw  x3, 12(x1)    LEDG = x3        (addr 0x40C)
00D : FC000EE3;  -- beq x0, x0, -36   -> LOOP (004)

[00E..0FF] : 00000013;  -- nop

END;
