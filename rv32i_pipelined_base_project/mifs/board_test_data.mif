-- =============================================================================
-- board_test_data.mif
-- Dados do programa de teste da placa (ver board_test_program.mif)
-- =============================================================================

DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN

000 : 00000400;  -- base MMIO
001 : 00800000;  -- mascara do bit 23 do contador de ciclos
002 : 00000100;  -- bit do LEDG[8]
003 : 0000000F;  -- usado para inverter KEY[3:0] (botoes ativos em nivel baixo)

[004..0FF] : 00000000;

END;
